{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "koishi-plugin-kurobridge",
  "version": "0.1.0",
  "description": "kurobridge-ws 官方参考对端：MC 服务器 ↔ 聊天平台群服互通（Koishi v4）",
  "contributors": [
    "Oppenheymu <oppenheymu@gmail.com>"
  ],
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "development": "./src/index.ts",
      "default": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "."
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/Kuro-Bridge/koishi-plugin-kurobridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuro-Bridge/koishi-plugin-kurobridge.git"
  },
  "keywords": [
    "chatbot",
    "koishi",
    "plugin"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check . && tsc --noEmit",
    "fix": "biome check --write . && tsc --noEmit",
    "changeset": "changeset",
    "release": "changeset version && tsdown && npm publish --access public"
  },
  "dependencies": {
    "@kuro-bridge/protocol": "^0.1.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "koishi": "npm:@koishi-ce/koishi-shim@^4.18.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.10"
  },
  "koishi": {
    "description": {
      "en": "一个 Koishi 插件",
      "zh": "一个 Koishi 插件"
    },
    "service": {}
  }
}
